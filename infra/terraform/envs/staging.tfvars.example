# Copy to staging.tfvars (gitignored) before running terraform plan/apply —
# same pattern as dev.tfvars.example.
#
# "staging" is the identity the public-demo Helm config (CronJob reset,
# tighter rate limit) is wired to — see infra/helm/agentforge/values-staging.yaml.
# Sized as cheaply as dev below since a spin-up/demo/teardown session
# doesn't need more capacity than that; bump the node/DB sizing up only if
# you're leaving it running continuously.

environment = "staging"
aws_region  = "us-east-1"

vpc_cidr           = "10.1.0.0/16"
az_count           = 2
single_nat_gateway = true

# t3.small, not t3.medium: this AWS account currently has a new-account
# restriction blocking any EC2 launch outside its Free-Tier-eligible list
# (confirmed via `aws ec2 describe-instance-types --filters
# Name=free-tier-eligible,Values=true` in CloudShell — request a quota
# increase from AWS Support if you want t3.medium back later). desired/min
# both raised to 2 to compensate: the ~2.06Gi of pod memory requests
# across staging's replica counts (values-staging.yaml) don't fit on a
# single t3.small (2GB, ~1.7GB allocatable) but do across two.
eks_cluster_version    = "1.30"
eks_node_instance_types = ["t3.small"]
eks_node_desired_size  = 2
eks_node_min_size      = 2
eks_node_max_size      = 2

rds_instance_class       = "db.t4g.micro"
rds_allocated_storage_gb = 20
rds_engine_version       = "16.4"
rds_multi_az             = false

redis_node_type       = "cache.t4g.micro"
redis_num_cache_nodes = 1

# Bootstrap already done for staging (2026-09-02) — the S3 bucket +
# DynamoDB lock table exist and the backend points at them (versions.tf).
# Leave this false: the bucket is an out-of-band backend target now, not
# a resource this state tracks. See "Bootstrapping state for a new
# environment" in docs/deployment-runbook.md before reusing this pattern
# for dev/prod.
create_state_bucket = false

# No custom domain yet — enable_ingress alone gets a real public
# http://<alb-hostname> URL (the AWS Load Balancer Controller's IRSA
# role), without needing Route53/ACM/a domain at all. Flip enable_tls on
# later once you own a domain (see docs/deployment-runbook.md) — it also
# needs enable_ingress = true, since TLS terminates on the same ALB.
enable_ingress      = true
enable_tls          = false
domain_name         = "staging.agentforge.example.com"
create_route53_zone = true
# WAF doesn't need a domain either — real protection for a
# public-URL demo at negligible cost for a short session.
enable_waf          = true
