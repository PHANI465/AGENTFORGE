      "targets": [
        {
          "expr": "rate(agentforge_tokens_in_total[5m])",
          "legendFormat": "Input tokens ({{model}})",
          "refId": "A"
        },
        {
          "expr": "rate(agentforge_tokens_out_total[5m])",
          "legendFormat": "Output tokens ({{model}})",
