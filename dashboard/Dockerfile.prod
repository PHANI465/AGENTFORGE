# Production image for Kubernetes/Helm deployment — NOT used by local
# docker-compose (that still uses ./Dockerfile's `npm run dev`, per
# Milestone 8). Vite bakes VITE_API_BASE_URL into the JS bundle at build
# time, so this image is built once per target environment (see
# .github/workflows/cd.yml) rather than once and reused everywhere.

FROM node:22-alpine AS build

ARG VITE_API_BASE_URL=http://localhost:8000

WORKDIR /app
COPY package*.json ./
RUN npm ci

COPY . .
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
RUN npm run build

FROM nginx:1.27-alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
