# Copy to .env and fill in real values. Never commit .env.
#
# Usage with the compose file in infra/docker/:
#   docker compose -f infra/docker/docker-compose.yml --env-file .env up -d

# --- Encryption (used to encrypt BYOK LLM keys at rest) ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_MASTER_KEY=

# --- LLM Provider (BYOK — bring your own key, ADR-002) ---
OPENAI_API_KEY=

# --- Postgres ---
POSTGRES_USER=agentforge
POSTGRES_PASSWORD=agentforge
POSTGRES_DB=agentforge
POSTGRES_DSN=postgresql+asyncpg://agentforge:agentforge@postgres:5432/agentforge

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- LiteLLM proxy (wired up in Milestone 3/7) ---
LITELLM_PROXY_URL=http://litellm:4000
LITELLM_MASTER_KEY=

# --- API Gateway ---
API_GATEWAY_SECRET_KEY=change-me-in-production
API_GATEWAY_PORT=8000

# --- Rate Limiting ---
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_RUN=10/minute

# --- Service ports (used by docker-compose) ---
AGENT_RUNTIME_PORT=8001
EVAL_SERVICE_PORT=8002
TRACE_COLLECTOR_PORT=8003
AUTH_SERVICE_PORT=8004

# --- Auth Service (Go, signup/login/OAuth/session tokens — Phase 3.3) ---
# Uses plain postgresql:// (pgx), not the +asyncpg dialect suffix the
# Python services use for the same database.
AUTH_POSTGRES_DSN=postgresql://agentforge:agentforge@postgres:5432/agentforge
# Generate with: openssl genrsa 2048
AUTH_SIGNING_KEY_PEM=
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
OAUTH_STATE_SECRET=
# From https://github.com/settings/developers (OAuth Apps) — callback URL
# must be <OAUTH_REDIRECT_BASE_URL>/auth/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# From https://console.cloud.google.com/apis/credentials — callback URL
# must be <OAUTH_REDIRECT_BASE_URL>/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_BASE_URL=http://localhost:8004

# --- Dashboard (Milestone 8) ---
# Runs on 3001, not 3000 — Grafana claimed 3000 in Milestone 5 before the
# dashboard existed, and moving it now would break every link already handed out.
DASHBOARD_API_BASE_URL=http://localhost:8000
DASHBOARD_ORIGINS=http://localhost:3001,http://localhost:5173

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=console

# --- Observability (Milestone 5) ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://trace-collector:8003
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
